    "def detect_outliers(df, column_name):\n",
    "    print(f\"\\nOutlier Analysis for Column: {column_name}\")\n",
    "    \n",
    "    # Summary statistics\n",
    "    print(df[column_name].describe())\n",
    "    \n",
    "    # Boxplot visualization\n",
    "    plt.figure(figsize=(8, 4))\n",
    "    sns.boxplot(x=df[column_name])\n",
    "    plt.title(f\"Boxplot - {column_name}\")\n",
    "    plt.show()\n",
    "    \n",
    "    # IQR calculation\n",
    "    q1 = df[column_name].quantile(0.25)\n",
    "    q3 = df[column_name].quantile(0.75)\n",
    "    iqr = q3 - q1\n",
    "    lower_bound = q1 - 1.5 * iqr\n",
    "    upper_bound = q3 + 1.5 * iqr\n",
    "    \n",
    "    print(f\"Lower bound: {lower_bound:.2f}, Upper bound: {upper_bound:.2f}\")\n",
    "    \n",
    "    # Outlier filtering\n",
    "    outliers = df[(df[column_name] < lower_bound) | (df[column_name] > upper_bound)]\n",
    "    print(f\"Number of outliers: {len(outliers)} out of {len(df)}\")\n",
    "\n",
    "# Running the function for 'age' and 'urine_output'\n",
    "detect_outliers(icu_data, 'age')\n",
    "detect_outliers(icu_data, 'urine_output')\n",
    "\n"
   ]
